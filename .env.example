# Environment Configuration
# Copy this to .env and fill in actual values

# Node environment
NODE_ENV=development

# Server
PORT=3001

# Database
DATABASE_URL=file:./data/forge.db

# JWT Authentication
# In development: set DEV_JWT_SECRET to a test value
# In production: set JWT_SECRET to a strong random value (minimum 32 characters)
JWT_SECRET=
DEV_JWT_SECRET=dev-secret-change-in-production

# Optional: OpenRouter AI (Phase 9)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Ollama (local LLM, Phase 9)
# OLLAMA_BASE_URL=http://localhost:11434
