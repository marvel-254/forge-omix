[TEMPLATE]
# Environment Configuration — fully local Docker stack
# Copy this to .env and adjust if needed (docker compose reads it automatically).

# Node environment
NODE_ENV=production

# Server (internal port; the UI is exposed on http://localhost:8080)
PORT=3001

# Database (kept on the forge-data volume)
DATABASE_URL=file:/data/forge.db

# ---------------------------------------------------------------------------
# AI providers — external & key-based; the stack ships with none bundled.
# Add the key(s) for whichever provider(s) you use; every configured provider
# is registered and selectable in the UI model dropdown (model ids are
# prefixed: openai/gpt-4o-mini, anthropic/claude-sonnet-4-5, …).
# AI_PROVIDER_ORDER (optional, comma-separated ids) reorders the fallback
# chain; otherwise registration order applies (Ollama last).
# ---------------------------------------------------------------------------
# 'cloud' (default) = registered keys only; 'mock' = offline demo provider;
# 'auto'/'local' also enable a host-installed Ollama at OLLAMA_BASE_URL.
AI_MODE=cloud
AI_PROVIDER_ORDER=

# OpenRouter (200+ models behind one key)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Groq (fast inference)
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Mistral
# MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Any OpenAI-compatible endpoint (LM Studio, vLLM, …) — used when native
# OPENAI_API_KEY is not set; models appear under the 'openai/' prefix.
# OPENAI_COMPAT_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_COMPAT_API_KEY=

# Ollama — NOT bundled. Only relevant if you run one on the host yourself:
# set AI_MODE=auto (or local) and point OLLAMA_BASE_URL at it.
# AI_MODE=auto
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# JWT Authentication
# In development: set DEV_JWT_SECRET to a test value
# In production: set JWT_SECRET to a strong random value (minimum 32 characters)
JWT_SECRET=
DEV_JWT_SECRET=dev-secret-change-in-production
