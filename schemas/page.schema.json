{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "https://forge-omix.io/schemas/page.schema.json",
  "title": "Omix Page",
  "description": "Page/screen definition within an Omix project. A page represents a single view or screen in the application, composed of a tree of components with layout and metadata. Example: { id: 'page_home', path: '/', title: 'Home', components: [...] }",
  "type": "object",
  "required": ["id", "path", "title", "components"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^page_[a-zA-Z0-9_-]{4,}$",
      "description": "Unique page identifier within the project. Example: page_home"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "description": "URL path for this page. Example: /dashboard or /products/:id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Page title displayed in browser tab and navigation."
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Brief page description for SEO and documentation."
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "https://forge-omix.io/schemas/component.schema.json"
      },
      "description": "Top-level component tree for this page."
    },
    "layout": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["default", "sidebar", "fullscreen", "blank", "auth"],
          "description": "Layout wrapper type for the page."
        },
        "containerWidth": {
          "type": "string",
          "enum": ["full", "contained", "narrow"],
          "description": "Maximum content width behavior."
        },
        "padding": {
          "type": ["string", "number"],
          "description": "Page-level padding. Can be a CSS value or token reference. Example: 16 or {spacing.lg}"
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "SEO title override."
        },
        "description": {
          "type": "string",
          "description": "SEO meta description."
        },
        "ogImage": {
          "type": "string",
          "format": "uri",
          "description": "Open Graph image URL."
        },
        "noindex": {
          "type": "boolean",
          "description": "Whether to exclude from search indexing."
        }
      },
      "additionalProperties": false
    },
    "responsiveRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["breakpoint", "modifications"],
        "properties": {
          "breakpoint": {
            "type": "string",
            "enum": ["xs", "sm", "md", "lg", "xl", "2xl"],
            "description": "Breakpoint at which these rules apply."
          },
          "modifications": {
            "type": "object",
            "description": "Layout/visibility modifications at this breakpoint.",
            "properties": {
                "hideComponents": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Component IDs to hide at this breakpoint."
                },
                "showComponents": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Component IDs to show at this breakpoint."
                },
                "reorderComponents": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "New component order by ID."
                },
                "layoutOverride": {
                  "$ref": "#/$defs/layoutOverride",
                  "description": "Layout override at this breakpoint."
                }
              },
              "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "description": "Responsive breakpoint rules for the page."
    },
    "auth": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Whether authentication is required to access this page."
        },
        "roles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required user roles to access this page."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "layoutOverride": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["default", "sidebar", "fullscreen", "blank", "auth"]
        },
        "containerWidth": {
          "type": "string",
          "enum": ["full", "contained", "narrow"]
        }
      }
    }
  }
}
