{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "https://forge-omix.io/schemas/media.schema.json",
  "title": "Media Component",
  "description": "Schema for media components (images, GIFs, videos) in the Omix visual builder. Media components support crop, resize, rotation, flip, and filters for images; native playback for video and GIF. Example: { id: 'comp_media_01H', type: 'Media', props: { src: { '$ref': 'assets.hero' }, mediaType: 'image', fit: 'cover', alt: 'Hero image' } }",
  "type": "object",
  "required": ["id", "type", "props"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^comp_[a-zA-Z0-9_-]{4,}$",
      "description": "Unique component identifier. Example: comp_hero_image"
    },
    "type": {
      "type": "string",
      "const": "Media",
      "description": "Component type. Always 'Media' for media components."
    },
    "name": {
      "type": "string",
      "maxLength": 100,
      "description": "Human-readable display name. Example: Hero Image"
    },
    "props": {
      "type": "object",
      "required": ["src", "mediaType", "fit"],
      "properties": {
        "src": {
          "type": "object",
          "description": "Asset reference. Format: { '$ref': 'assets.<assetId>' }",
          "properties": {
            "$ref": {
              "type": "string",
              "pattern": "^assets\\."
            }
          },
          "additionalProperties": false
        },
        "mediaType": {
          "type": "string",
          "enum": ["image", "gif", "video"],
          "description": "Type of media asset. Determines rendering and editing options."
        },
        "alt": {
          "type": "string",
          "maxLength": 500,
          "description": "Alt text for accessibility. Required for images and GIFs."
        },
        "fit": {
          "type": "string",
          "enum": ["contain", "cover", "fill", "none"],
          "default": "cover",
          "description": "CSS object-fit behavior for the media."
        },
        "position": {
          "type": "object",
          "description": "CSS object-position. 0-1 representing percentage.",
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
            "y": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 }
          },
          "additionalProperties": false
        },
        "edit": {
          "type": "object",
          "description": "Image edit state. Null if unedited.",
          "properties": {
            "crop": {
              "type": "object",
              "properties": {
                "x": { "type": "number", "minimum": 0 },
                "y": { "type": "number", "minimum": 0 },
                "width": { "type": "number", "minimum": 1 },
                "height": { "type": "number", "minimum": 1 },
                "unit": { "type": "string", "enum": ["px", "%"], "default": "px" }
              },
              "additionalProperties": false
            },
            "rotation": {
              "type": "integer",
              "enum": [0, 90, 180, 270],
              "default": 0,
              "description": "Rotation in degrees (clockwise)."
            },
            "flip": {
              "type": "object",
              "properties": {
                "horizontal": { "type": "boolean", "default": false },
                "vertical": { "type": "boolean", "default": false }
              },
              "additionalProperties": false
            },
            "filters": {
              "type": "object",
              "properties": {
                "brightness": { "type": "number", "minimum": 0, "maximum": 200, "default": 100 },
                "contrast": { "type": "number", "minimum": 0, "maximum": 200, "default": 100 },
                "saturate": { "type": "number", "minimum": 0, "maximum": 200, "default": 100 },
                "blur": { "type": "number", "minimum": 0, "maximum": 20, "default": 0 },
                "grayscale": { "type": "number", "minimum": 0, "maximum": 100, "default": 0 }
              },
              "additionalProperties": false
            }
          },
          "nullable": true,
          "additionalProperties": false
        },
        "videoOptions": {
          "type": "object",
          "description": "Video-specific playback options. Only used when mediaType is 'video'.",
          "properties": {
            "autoplay": { "type": "boolean", "default": false },
            "loop": { "type": "boolean", "default": false },
            "muted": { "type": "boolean", "default": true },
            "controls": { "type": "boolean", "default": true },
            "poster": {
              "type": ["object", "null"],
              "description": "Poster image asset reference.",
              "properties": {
                "$ref": { "type": "string", "pattern": "^assets\\." }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
