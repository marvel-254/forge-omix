{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "https://forge-omix.io/schemas/template.schema.json",
  "title": "Omix Template",
  "description": "Template definition for reusable Omix page/component blueprints. Templates can be shared across projects and parameterized with variables. Example: { id: 'tmpl_dashboard', name: 'Dashboard Layout', version: '2.1.0', variables: [...] }",
  "type": "object",
  "required": ["id", "name", "version", "schema"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tmpl_[a-zA-Z0-9_-]{4,}$",
      "description": "Unique template identifier. Example: tmpl_landing_page"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable template name. Example: Marketing Landing Page"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Detailed description of the template."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
      "description": "Semantic version of the template. Example: 1.2.0"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Author name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Author email."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Author URL or profile."
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "license": {
      "type": "string",
      "enum": ["MIT", "Apache-2.0", "BSD-3-ISC", "GPL-3.0", "LGPL-3.0", "MPL-2.0", "Unlicense", "Proprietary"],
      "description": "License under which the template is distributed."
    },
    "category": {
      "type": "string",
      "enum": ["landing", "dashboard", "e-commerce", "blog", "portfolio", "auth", "form", "layout", "component", "page", "flow", "other"],
      "description": "Template category for organization and discovery."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30,
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "maxItems": 20,
      "description": "Searchable tags. Example: [react, responsive, dark-mode]"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
            "description": "Variable name used for substitution. Example: primaryColor"
          },
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "color", "image", "component", "array", "object"],
            "description": "Variable data type."
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of this variable."
          },
          "default": {
            "description": "Default value if not provided."
          },
          "required": {
            "type": "boolean",
            "description": "Whether this variable must be provided. Defaults to false."
          },
          "options": {
            "type": "array",
            "description": "Allowed values for enum-like variables."
          }
        },
        "additionalProperties": false
      },
      "description": "Parameterizable variables that customize the template."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Dependency package name. Example: react-icons"
          },
          "version": {
            "type": "string",
            "description": "Semver version range. Example: ^18.0.0"
          },
          "type": {
            "type": "string",
            "enum": ["npm", "template", "component"],
            "description": "Type of dependency."
          }
        },
        "additionalProperties": false
      },
      "description": "External dependencies required by this template."
    },
    "preview": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "format": "uri",
          "description": "Preview image URL for the template."
        },
        "demoUrl": {
          "type": "string",
          "format": "uri",
          "description": "Live demo URL."
        }
      },
      "additionalProperties": false
    },
    "schema": {
      "type": "object",
      "description": "The actual template content — can be a page schema, component schema, or project fragment.",
      "additionalProperties": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp."
    }
  },
  "additionalProperties": false
}
