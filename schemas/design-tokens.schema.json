{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "https://forge-omix.io/schemas/design-tokens.schema.json",
  "title": "Omix Design Tokens",
  "description": "Design token system for consistent visual styling across an Omix project. Tokens define colors, typography, spacing, radii, shadows, breakpoints, and motion. Example: { colors: { primary: '#3B82F6', ... }, typography: { fontFamily: { sans: 'Inter, sans-serif' } } }",
  "type": "object",
  "properties": {
    "colors": {
      "type": "object",
      "description": "Color palette tokens. Keys are semantic color names, values are CSS color strings.",
      "properties": {
        "primary": { "type": "string", "description": "Primary brand color. Example: #3B82F6" },
        "secondary": { "type": "string", "description": "Secondary brand color." },
        "accent": { "type": "string", "description": "Accent color for highlights." },
        "background": { "type": "string", "description": "Default background color." },
        "surface": { "type": "string", "description": "Surface/card background color." },
        "text": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "disabled": { "type": "string" },
            "inverse": { "type": "string" }
          },
          "additionalProperties": true
        },
        "border": { "type": "string", "description": "Default border color." },
        "error": { "type": "string", "description": "Error/danger color." },
        "warning": { "type": "string", "description": "Warning color." },
        "success": { "type": "string", "description": "Success color." },
        "info": { "type": "string", "description": "Info color." }
      },
      "additionalProperties": { "type": ["string", "object"] }
    },
    "typography": {
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "object",
          "properties": {
            "sans": { "type": "string", "description": "Sans-serif font family. Example: Inter, system-ui, sans-serif" },
            "serif": { "type": "string", "description": "Serif font family." },
            "mono": { "type": "string", "description": "Monospace font family." },
            "display": { "type": "string", "description": "Display/heading font family." }
          },
          "additionalProperties": { "type": "string" }
        },
        "fontSize": {
          "type": "object",
          "properties": {
            "xs": { "type": "string", "description": "Extra small font size. Example: 0.75rem" },
            "sm": { "type": "string", "description": "Small font size." },
            "base": { "type": "string", "description": "Base font size." },
            "lg": { "type": "string", "description": "Large font size." },
            "xl": { "type": "string", "description": "Extra large font size." },
            "2xl": { "type": "string" },
            "3xl": { "type": "string" },
            "4xl": { "type": "string" },
            "5xl": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "fontWeight": {
          "type": "object",
          "properties": {
            "thin": { "type": ["string", "number"] },
            "light": { "type": ["string", "number"] },
            "normal": { "type": ["string", "number"] },
            "medium": { "type": ["string", "number"] },
            "semibold": { "type": ["string", "number"] },
            "bold": { "type": ["string", "number"] },
            "black": { "type": ["string", "number"] }
          },
          "additionalProperties": { "type": ["string", "number"] }
        },
        "lineHeight": {
          "type": "object",
          "properties": {
            "tight": { "type": ["string", "number"] },
            "normal": { "type": ["string", "number"] },
            "relaxed": { "type": ["string", "number"] },
            "loose": { "type": ["string", "number"] }
          },
          "additionalProperties": { "type": ["string", "number"] }
        },
        "letterSpacing": {
          "type": "object",
          "properties": {
            "tighter": { "type": "string" },
            "tight": { "type": "string" },
            "normal": { "type": "string" },
            "wide": { "type": "string" },
            "wider": { "type": "string" },
            "widest": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "heading": {
          "type": "object",
          "properties": {
            "h1": {
              "type": "object",
              "properties": {
                "fontSize": { "type": "string" },
                "fontWeight": { "type": ["string", "number"] },
                "lineHeight": { "type": ["string", "number"] },
                "letterSpacing": { "type": "string" }
              },
              "additionalProperties": true
            },
            "h2": {
              "type": "object",
              "properties": {
                "fontSize": { "type": "string" },
                "fontWeight": { "type": ["string", "number"] },
                "lineHeight": { "type": ["string", "number"] },
                "letterSpacing": { "type": "string" }
              },
              "additionalProperties": true
            },
            "h3": {
              "type": "object",
              "properties": {
                "fontSize": { "type": "string" },
                "fontWeight": { "type": ["string", "number"] },
                "lineHeight": { "type": ["string", "number"] }
              },
              "additionalProperties": true
            },
            "h4": {
              "type": "object",
              "properties": {
                "fontSize": { "type": "string" },
                "fontWeight": { "type": ["string", "number"] }
              },
              "additionalProperties": true
            },
            "h5": {
              "type": "object",
              "properties": {
                "fontSize": { "type": "string" },
                "fontWeight": { "type": ["string", "number"] }
              },
              "additionalProperties": true
            },
            "h6": {
              "type": "object",
              "properties": {
                "fontSize": { "type": "string" },
                "fontWeight": { "type": ["string", "number"] }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "spacing": {
      "type": "object",
      "description": "Spacing/sizing scale tokens. Keys are size names, values are CSS length strings.",
      "properties": {
        "0": { "type": "string", "description": "Zero spacing. Example: 0" },
        "xs": { "type": "string", "description": "Extra small spacing. Example: 0.25rem" },
        "sm": { "type": "string", "description": "Small spacing." },
        "md": { "type": "string", "description": "Medium spacing." },
        "lg": { "type": "string", "description": "Large spacing." },
        "xl": { "type": "string", "description": "Extra large spacing." },
        "2xl": { "type": "string" },
        "3xl": { "type": "string" },
        "4xl": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "radius": {
      "type": "object",
      "description": "Border radius tokens.",
      "properties": {
        "none": { "type": "string", "description": "No radius. Example: 0" },
        "sm": { "type": "string" },
        "md": { "type": "string" },
        "lg": { "type": "string" },
        "xl": { "type": "string" },
        "2xl": { "type": "string" },
        "full": { "type": "string", "description": "Fully rounded. Example: 9999px" }
      },
      "additionalProperties": { "type": "string" }
    },
    "shadows": {
      "type": "object",
      "description": "Box shadow tokens.",
      "properties": {
        "none": { "type": "string" },
        "sm": { "type": "string" },
        "md": { "type": "string" },
        "lg": { "type": "string" },
        "xl": { "type": "string" },
        "2xl": { "type": "string" },
        "inner": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "breakpoints": {
      "type": "object",
      "description": "Responsive breakpoint values in pixels.",
      "properties": {
        "xs": { "type": "number", "description": "Extra small breakpoint. Example: 320" },
        "sm": { "type": "number", "description": "Small breakpoint. Example: 640" },
        "md": { "type": "number", "description": "Medium breakpoint. Example: 768" },
        "lg": { "type": "number", "description": "Large breakpoint. Example: 1024" },
        "xl": { "type": "number", "description": "Extra large breakpoint. Example: 1280" },
        "2xl": { "type": "number", "description": "2X large breakpoint. Example: 1536" }
      },
      "additionalProperties": { "type": "number" }
    },
    "motion": {
      "type": "object",
      "description": "Motion/animation tokens.",
      "properties": {
        "duration": {
          "type": "object",
          "properties": {
            "fast": { "type": "string", "description": "Fast duration. Example: 150ms" },
            "normal": { "type": "string", "description": "Normal duration." },
            "slow": { "type": "string", "description": "Slow duration." },
            "slower": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "easing": {
          "type": "object",
          "properties": {
            "linear": { "type": "string" },
            "easeIn": { "type": "string" },
            "easeOut": { "type": "string" },
            "easeInOut": { "type": "string" },
            "spring": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "keyframes": {
          "type": "object",
          "description": "Named keyframe animations.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "zIndex": {
      "type": "object",
      "description": "Z-index layering tokens.",
      "properties": {
        "base": { "type": "number" },
        "dropdown": { "type": "number" },
        "sticky": { "type": "number" },
        "overlay": { "type": "number" },
        "modal": { "type": "number" },
        "popover": { "type": "number" },
        "tooltip": { "type": "number" },
        "toast": { "type": "number" }
      },
      "additionalProperties": { "type": "number" }
    }
  },
  "additionalProperties": true
}
